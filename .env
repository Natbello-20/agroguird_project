# AgroGuard Configuration
# Google Translate uses GOOGLE_APPLICATION_CREDENTIALS environment variable

# Google Translate (Free Tier - 500k characters/month free)
# Set this to the path of your Google Cloud service account JSON key file
# Download from: https://console.cloud.google.com/
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Application Settings
DEBUG=False
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Settings (for frontend access)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Model Configuration (for future use with real TensorFlow model)
# MODEL_PATH=./models/disease_detection_model.h5

# Weather API Configuration (optional - for real weather integration)
# WEATHER_API_KEY=your_weather_api_key_here
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# Database Configuration - SQLite (Development)
# For production, use PostgreSQL: postgresql://username:password@localhost/agroguard
DATABASE_URL=sqlite:///agroguard.db
DATABASE_ECHO=False

# JWT Authentication (Phase 1+)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Redis Cache Configuration (Phase 2+)
REDIS_URL=redis://localhost:6379/0

# Image Storage Configuration (Phase 1+)
IMAGE_UPLOAD_DIR=./images/scans
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=jpg,jpeg,png
